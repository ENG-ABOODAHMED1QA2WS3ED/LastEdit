// name-normalizer.js - v7.0 Production Grade
// Based on Bank Reconciliation Matching Engine spec

class NameNormalizer {

  // === PHASE 1: TEXT NORMALIZATION ===

  static normalizeArabic(name) {
    if (!name) return '';
    // NFKD: fixes Arabic Presentation Forms (FB50-FDFF, FE70-FEFF)
    let n = name.normalize('NFKD');
    // Remove diacritics (tashkeel)
    n = n.replace(/[\u0610-\u061A\u064B-\u065F\u0670]/g, '');
    // Normalize Arabic letter variations
    n = n.replace(/[أإآٱ]/g, 'ا');
    n = n.replace(/ة/g, 'ه');
    n = n.replace(/[ىی]/g, 'ي');  // includes Farsi yeh U+06CC
    n = n.replace(/ؤ/g, 'و');
    n = n.replace(/ئ/g, 'ي');
    n = n.replace(/\s+/g, ' ').trim();
    return n;
  }

  static normalize(name) {
    if (!name) return '';
    let n = name.normalize('NFKD');
    n = n.toLowerCase().trim();
    n = this.normalizeArabic(n);
    // Remove non-word chars except Arabic and spaces
    n = n.replace(/[^\w\s\u0600-\u06FF]/g, ' ');
    n = n.replace(/\s+/g, ' ').trim();
    return n;
  }

  static getWords(name) {
    return this.normalize(name).split(/\s+/).filter(w => w.length > 1);
  }

  // === NAME COMPONENT EXTRACTION (Critical for Hard Gates) ===

  static COMMON_FIRST_NAMES = new Set([
    'محمد', 'احمد', 'علي', 'عمر', 'خالد', 'حسن', 'حسين', 'ابراهيم', 'يوسف', 'سعيد',
    'عبد', 'صالح', 'ماهر', 'طارق', 'سامي', 'رامي', 'نادر', 'وليد', 'فادي', 'هاني',
    'mohammed', 'mohammad', 'mohamed', 'muhammad', 'muhamad', 'muhamed',
    'ahmad', 'ahmed', 'ali', 'omar', 'khaled', 'khalid', 'hassan', 'hussein',
    'ibrahim', 'yousef', 'youssef', 'joseph', 'said', 'saeed', 'saleh',
    'maher', 'tariq', 'sami', 'rami', 'nader', 'waleed', 'walid', 'fadi', 'hani'
  ]);

  static PREFIXES = new Set(['ابو', 'أبو', 'abu', 'abo', 'al', 'el', 'ال']);

  static extractNameComponents(name) {
    if (!name) return { type: 'empty', firstName: '', lastName: '', fullName: '', key: '' };

    const normalized = this.normalize(name);
    const words = normalized.split(/\s+/).filter(w => w.length > 1);

    // Company detection
    const companyIndicators = ['شركه', 'شركة', 'مؤسسه', 'مؤسسة', 'ltd', 'co', 'inc', 'corp', 'llc'];
    if (companyIndicators.some(ind => normalized.includes(ind))) {
      return { type: 'company', firstName: '', lastName: '', fullName: normalized, key: normalized };
    }

    if (words.length === 0) {
      return { type: 'empty', firstName: '', lastName: '', fullName: '', key: '' };
    }

    if (words.length === 1) {
      return {
        type: 'single_name',
        firstName: words[0],
        lastName: '',
        fullName: normalized,
        key: words[0],
        penaltyScore: 0.20
      };
    }

    // Handle "abu/abo" prefix as part of family name
    let lastName = words[words.length - 1];
    let lastNameStart = words.length - 1;

    // If last word is very short or second-to-last is a prefix, combine
    if (lastNameStart > 0) {
      const prev = words[lastNameStart - 1];
      if (this.PREFIXES.has(prev)) {
        lastName = prev + ' ' + lastName;
        lastNameStart--;
      }
    }

    return {
      type: 'person',
      firstName: words[0],
      lastName: lastName,
      middleNames: words.slice(1, lastNameStart),
      fullName: normalized,
      key: lastName,
      penaltyScore: 0
    };
  }

  // === HARD GATE: Family Name Match ===


  // === ARABIC-ENGLISH NAME TRANSLITERATION ===
  static _nameMap = {
    // الأسماء الأولى الشائعة
    'طاهر': 'taher', 'احمد': 'ahmed', 'محمد': 'mohammed', 'محمود': 'mahmoud',
    'ابراهيم': 'ibrahim', 'اسماعيل': 'ismail', 'عبدالله': 'abdullah',
    'عبد': 'abd', 'خالد': 'khaled', 'عمر': 'omar', 'علي': 'ali',
    'حسن': 'hassan', 'حسين': 'hussain', 'يوسف': 'yousef', 'سعيد': 'saeed',
    'صالح': 'saleh', 'رامي': 'rami', 'سامي': 'sami', 'هاني': 'hani',
    'وليد': 'waleed', 'نادر': 'nader', 'عماد': 'emad', 'اياد': 'eiad',
